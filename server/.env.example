# EmoBridge Server - environment template
# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored and must never be committed.

# --- PostgreSQL connection (all required) ---
DB_USER=appuser
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=emobridge_db

# --- Authentication (required) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Server (optional, defaults shown) ---
HOST=127.0.0.1
PORT=8000
DEBUG=False
